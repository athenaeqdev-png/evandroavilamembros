{
  "name": "evandro-avila-membros",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "build": "npm run assets:prepare",
    "predev": "npm run assets:prepare",
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply membros-local --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --env=\"\" --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "predeploy": "npm run assets:prepare",
    "deploy": "wrangler deploy --env=\"\"",
    "versions:upload": "npm run assets:prepare && wrangler versions upload --env=\"\"",
    "predeploy:preview": "npm run assets:prepare",
    "deploy:preview": "wrangler deploy --env preview",
    "admin:create": "node scripts/create-dev-admin.mjs",
    "admin:update:preview": "node scripts/update-preview-admin.mjs"
  },
  "devDependencies": { "@cloudflare/workers-types": "5.20260921.1", "typescript": "^5.9.2", "vitest": "^3.2.4", "wrangler": "^4.38.0" }
}
